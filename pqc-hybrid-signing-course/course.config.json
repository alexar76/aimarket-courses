{
  "id": "pqc-hybrid-signing",
  "github_repo": "alexar76/pqc-hybrid-signing-course",
  "github_pages": "https://alexar76.github.io/pqc-hybrid-signing-course/",
  "clone_dir": "pqc-hybrid-signing-course",
  "package_name": "pqc-hybrid-signing-course",
  "title": "PQC · Hybrid Signing",
  "description": "Hands-on course on hybrid signatures in the AIMarket stack: why PQ alone is not enough, how dual keys bind a receipt, and how to verify without trusting the hub.",
  "pip_extras_default": "[dev]",
  "module_count": 5,
  "modules": [
    "m1",
    "m2",
    "m3",
    "m4",
    "m5"
  ],
  "labs": [
    {
      "stem": "lab01_why_hybrid",
      "module": "m1",
      "track": "basic"
    },
    {
      "stem": "lab02_key_identity",
      "module": "m2",
      "track": "basic"
    },
    {
      "stem": "lab03_sign_receipt",
      "module": "m3",
      "track": "basic"
    },
    {
      "stem": "lab04_verify_offline",
      "module": "m4",
      "track": "basic"
    },
    {
      "stem": "lab05_hybrid_gate_capstone",
      "module": "m5",
      "track": "advanced"
    }
  ],
  "quickstart_commands": [
    "git clone https://github.com/alexar76/aimarket-courses.git",
    "cd aimarket-courses/pqc-hybrid-signing-course",
    "pip install -e \".[pqc,dev]\"",
    "python labs/lab01_why_hybrid.py",
    "python labs/run_exercises.py"
  ],
  "smoke_labs": [
    "lab01_why_hybrid",
    "lab02_key_identity",
    "lab03_sign_receipt",
    "lab04_verify_offline",
    "lab05_hybrid_gate_capstone"
  ]
}
