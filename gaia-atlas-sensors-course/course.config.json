    {
      "stem": "lab05_add_sensor_capstone",
      "module": "m5",
      "track": "advanced"
    }
  ],
  "quickstart_commands": [
    "git clone https://github.com/alexar76/aimarket-courses.git",
    "cd aimarket-courses/gaia-atlas-sensors-course",
